# --- API DraftDB (back FastAPI) ---
# Même origine : les appels passent par le proxy Vite (/api).
# Une URL absolue ne fonctionne que si le back active CORS (ce qui n'est pas le cas).
VITE_API_URL=/

# Cible du proxy Vite pour /api (server et preview). Pas de préfixe VITE_ : non exposé au client.
# En production, c'est le reverse proxy qui transmet /api/.
API_PROXY_TARGET=http://localhost:8000

# PROVISOIRE (remplacé par l'authentification).
# Concepteur du seed ; le back exige un UUID existant dans `utilisateur`, sinon 401.
# Le relecteur est 00000000-0000-0000-0000-000000000002.
# Surchargé par localStorage['draftdb_user_id'].
VITE_USER_ID=00000000-0000-0000-0000-000000000001
